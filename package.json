{
  "name": "clueops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node tools/build-admin.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "benchmark": "tsx tools/benchmark.ts",
    "format:check": "prettier --check .github src test tools/*.mjs tools/*.ts examples",
    "check-config": "tsx src/index.ts --check-config",
    "predev": "node tools/build-prompts.mjs",
    "prebuild": "node tools/build-prompts.mjs",
    "pretypecheck": "node tools/build-prompts.mjs",
    "pretest": "node tools/build-prompts.mjs",
    "pretest:integration": "node tools/build-prompts.mjs",
    "prebenchmark": "node tools/build-prompts.mjs",
    "precheck-config": "node tools/build-prompts.mjs",
    "test:admin-ui": "node tools/check-admin-ui.mjs",
    "pretest:admin-ui": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "@types/ssh2": "1.15.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@openai/codex-sdk": "0.166.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fs-native-extensions": "1.5.3",
    "ssh2": "1.17.0",
    "yaml": "2.9.1"
  }
}
